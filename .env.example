# Copy to .env for local execution:  cp .env.example .env
#
# Serverless Postgres connection string (Neon.tech / Supabase / Render free tier).
DATABASE_URL="postgresql://username:password@ep-hostname.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Optional pipeline tuning (defaults shown) ---

# Hourly history pulled on the very first run (clean table empty). Open-Meteo allows up to 92.
# BACKFILL_DAYS=90

# Hourly history pulled on every subsequent run. Overlap re-states recent days via UPSERT.
# INCREMENTAL_DAYS=4

# A day is only promoted to the clean layer once it has this many valid hourly observations.
# MIN_HOURS_PER_DAY=6

# Raw hourly rows older than this are pruned from staging to stay inside free-tier storage.
# STAGING_RETENTION_DAYS=14

# --- Local integration tests (pytest) ---
# Point this at a THROWAWAY database. tests/test_sql_mart.py creates and drops the
# aqi_pipeline schema inside it. Left unset, the SQL integration tests skip.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/aqi_test"
